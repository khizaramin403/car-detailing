---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Service Areas | Apex Auto Detailing"
  description="Explore our mobile auto detailing coverage areas and private studio workshop location."
  showNav={true}
  showFooter={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 bg-red-500/10 px-3 py-1 rounded-md border border-red-500/20">
        Locations & Coverage
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Outfit'] mt-4 mb-6">
        Mobile Units & Studio Locations.
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed">
        We offer on-site mobile detailing at your home or office across the metropolitan area, plus temperature-controlled studio bays for multi-day ceramic coatings.
      </p>
    </div>
  </div>
</Layout>
