---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Pricing & Packages | Apex Auto Detailing"
  description="Transparent detailing packages and pricing for cars, SUVs, and luxury exotics."
  showNav={true}
  showFooter={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 bg-red-500/10 px-3 py-1 rounded-md border border-red-500/20">
        Transparent Pricing
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Outfit'] mt-4 mb-6">
        Detailing Packages Tailored To Your Needs.
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed">
        Choose from our Essential Wash & Seal, Interior Deep Clean, or Ceramic Pro Ultimate package with lifetime gloss.
      </p>
    </div>
  </div>
</Layout>
