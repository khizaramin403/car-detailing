---
import Layout from "../layouts/Layout.astro";
import heroBackground from "../assets/Background_Herosection.webp";
import HeroSection from "../components/home/HeroSection.jsx";
import TrustBar from "../components/home/TrustBar.jsx";
import ServicesSection from "../components/home/ServicesSection.jsx";
import PricingSection from "../components/home/PricingSection.jsx";
import HowItWorksSection from "../components/home/HowItWorksSection.jsx";
import VehicleTypesSection from "../components/home/VehicleTypesSection.jsx";
import OptionsComparisonSection from "../components/home/OptionsComparisonSection.jsx";
import CarWashAndVacSection from "../components/home/CarWashAndVacSection.jsx";
import AboutBrothersSection from "../components/home/AboutBrothersSection.jsx";
import ServiceAreaSection from "../components/home/ServiceAreaSection.jsx";
import ServiceAreaSection2 from "../components/home/ServiceAreaSection2.jsx";
import GoogleReviewsSection from "../components/home/GoogleReviewsSection.astro";
import WhyDifferentSection from "../components/home/WhyDifferentSection.jsx";
import MorrisConditionsCostSection from "../components/home/MorrisConditionsCostSection.jsx";
import ProjectGallerySection from "../components/home/ProjectGallerySection.jsx";
import FaqSection from "../components/home/FaqSection.jsx";
import FinalCtaSection from "../components/home/FinalCtaSection.jsx";
---

<Layout
	title="Dos Bros Auto Detailing | Morris, MN Mobile Car Detailing"
	description="Professional mobile car detailing in Morris, Minnesota. Interior detailing, exterior hand wash, ceramic coating, truck & farm vehicles."
	showNav={true}
	showFooter={true}
	preloadImage={heroBackground.src}
>
	<HeroSection />
	<TrustBar />
	<ServicesSection client:visible />
	<PricingSection client:visible />
	<HowItWorksSection client:visible />
	<AboutBrothersSection />
	<VehicleTypesSection client:visible />
	<OptionsComparisonSection client:visible />
	<CarWashAndVacSection client:visible />
	<ServiceAreaSection client:visible />
	<!-- <ServiceAreaSection2 client:visible /> -->
	<GoogleReviewsSection />
	<WhyDifferentSection client:visible />
	<MorrisConditionsCostSection client:visible />
	<ProjectGallerySection client:visible />
	<FaqSection client:visible />
	<FinalCtaSection client:visible />
</Layout>
