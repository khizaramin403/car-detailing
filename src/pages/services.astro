---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Our Services | Apex Auto Detailing"
  description="Explore our full range of ceramic coating, paint correction, interior detailing, and mobile packages."
  showNav={true}
  showFooter={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 bg-red-500/10 px-3 py-1 rounded-md border border-red-500/20">
        Signature Services
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Outfit'] mt-4 mb-6">
        Comprehensive Car Care & Paint Protection.
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed">
        From multi-stage paint compounding to 7-year Graphene ceramic coatings, we offer tailor-made detailing packages for everyday drivers and exotic sports cars.
      </p>
    </div>
  </div>
</Layout>
