---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="About Us | Apex Auto Detailing"
  description="Learn about our story, certified master detailers, and precision paint restoration philosophy."
  showNav={true}
  showFooter={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="max-w-3xl">
      <span class="text-xs font-bold uppercase tracking-widest text-red-500 bg-red-500/10 px-3 py-1 rounded-md border border-red-500/20">
        About Our Studio
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white font-['Outfit'] mt-4 mb-6">
        Precision, Passion & Perfection in Every Curve.
      </h1>
      <p class="text-lg text-neutral-300 leading-relaxed mb-6">
        Apex Auto Detailing was founded by automotive enthusiasts dedicated to taking vehicle reconditioning to an art form. We combine IDA-certified paint correction techniques with aerospace ceramic coatings.
      </p>
    </div>
  </div>
</Layout>
