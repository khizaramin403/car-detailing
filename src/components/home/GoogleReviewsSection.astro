---
// Google Reviews Section powered by Trustindex
---

<section id="reviews" class="py-14 sm:py-18 lg:py-20 bg-neutral-950 text-white relative overflow-hidden border-t border-b border-neutral-900">
  <!-- Subtle ambient background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-red-600/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neutral-900 border border-neutral-800 text-xs font-semibold text-neutral-300 mb-3">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>VERIFIED GOOGLE REVIEWS</span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-white font-['Outfit'] tracking-tight">
        What Our Customers <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-500">Say About Us</span>
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-neutral-400 max-w-xl mx-auto">
        Real feedback from vehicle owners across Morris, Stevens County, and surrounding Minnesota communities.
      </p>
    </div>

    <!-- Trustindex Widget Container -->
    <div class="w-full min-h-[160px] flex justify-center">
      <script is:inline defer async src='https://cdn.trustindex.io/loader.js?b28d2f18056a848a560609ac2f1'></script>
    </div>
  </div>
</section>
